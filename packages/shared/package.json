    },
    "./utils/common": {
      "import": "./dist/utils/common.js",
      "require": "./dist/utils/common.js",
      "types": "./dist/utils/common.d.ts"
    },
    "./utils/imageUtils": {
      "import": "./dist/utils/imageUtils.js",
