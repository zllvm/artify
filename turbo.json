{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:max": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^dev"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "lint": {},
    "type-check": {},
    "clean": {
      "cache": false
    },
    "debug": {
      "cache": false,
      "persistent": true
    }
  }
}
