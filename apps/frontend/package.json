{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect=9229 --enable-source-maps' next dev -H 0.0.0.0 --turbopack",
    "dev:max": "NODE_OPTIONS='--inspect=9229 --enable-source-maps' dotenv -e .env.max -- next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "build:max": "dotenvx run -f .env.max -- next build",
    "lint": "eslint .",
    "start": "next start",
    "prod": "pnpm run build:max && next start"
  },
  "dependencies": {
    "@artify/shared": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "@reduxjs/toolkit": "^2.10.1",
    "@sentry/nextjs": "^10.26.0",
    "jose": "^6.1.0",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "^9.2.0",
    "swr": "^2.3.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
