# --- Build stage ---
FROM node:24-slim AS builder
WORKDIR /app

# Update system packages to patch vulnerabilities
RUN apt-get update && apt-get upgrade -y && apt-get clean

RUN corepack enable && corepack prepare pnpm@latest --activate

# Build-time environment variables for Next.js config
ARG NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}

# Sentry DSN for client-side error tracking (baked into bundle at build time)
ARG SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig*.json ./
COPY turbo.json ./
COPY packages ./packages
COPY apps/frontend ./apps/frontend

RUN pnpm install --frozen-lockfile

# Use BuildKit secret for Sentry auth token (won't be cached or logged)
RUN --mount=type=secret,id=sentry_auth_token \
    SENTRY_AUTH_TOKEN=$(cat /run/secrets/sentry_auth_token 2>/dev/null || echo "") \
    pnpm turbo run build --filter=frontend

RUN mkdir -p /app/apps/frontend/.next/cache && chown -R 65532:65532 /app

# --- Run stage ---
FROM gcr.io/distroless/nodejs22-debian12
WORKDIR /app

COPY --from=builder /app/apps/frontend/.next/standalone ./
COPY --from=builder /app/apps/frontend/.next/static ./apps/frontend/.next/static
COPY --from=builder /app/apps/frontend/public ./apps/frontend/public

USER nonroot
CMD ["apps/frontend/server.js"]